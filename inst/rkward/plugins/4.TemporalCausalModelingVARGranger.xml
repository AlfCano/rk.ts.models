	<logic>
		<convert id="cond_var_df" sources="var_src_mode.string" mode="equals" standard="df" />
		<convert id="cond_var_mts" sources="var_src_mode.string" mode="equals" standard="mts" />
		<convert id="cond_var_auto" sources="var_lag_mode.string" mode="equals" standard="auto" />
		<convert id="cond_var_man" sources="var_lag_mode.string" mode="equals" standard="manual" />
		<connect governor="cond_var_df" client="frm_var_df.enabled" />
		<connect governor="cond_var_mts" client="frm_var_mts.enabled" />
		<connect governor="cond_var_auto" client="frm_var_auto.enabled" />
		<connect governor="cond_var_man" client="frm_var_man.enabled" />
		<script>
			gui.addChangeCommand("var_src_mode.string", "update_var_root()");
	    gui.addChangeCommand("var_df.available", "update_var_root()");
	    function update_var_root() {
	       var mode = gui.getValue("var_src_mode.string");
	       var df = gui.getValue("var_df.available");
	       if (mode === "df") {
	          if (df !== "") {
	             gui.setValue("var_vs.root", df);
	          } else {
	             gui.setValue("var_vs.root", "");
	          }
	       } else {
	          gui.setValue("var_vs.root", "");
	       }
	    }
		</script>
	</logic>
