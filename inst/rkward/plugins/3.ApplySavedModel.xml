	<code file="3.ApplySavedModel.js" />
	<help file="3.ApplySavedModel.rkh" />
	<!--
		<dependencies>
		</dependencies>
	-->
	<logic>
		<convert id="cond_app_ts" sources="app_mode.string" mode="equals" standard="ts" />
		<connect governor="cond_app_ts" client="frm_app_new.enabled" />
	</logic>
	<dialog label="3. Apply Saved Model">
		<row id="row_vMNDMNDSMO">
			<varselector id="app_vs" />
			<column id="clm_tMNDMNDSMO">
				<tabbook>
					<tab label="Model &amp; New Data" id="tab_ModlNwDt">
						<column id="clm_vSMOAAARIM">
							<varslot id="app_mod" label="Saved Model Object (Arima / ets)" source="app_vs" classes="Arima ARIMA ets" required="true" />
							<radio id="app_mode" label="Application Mode">
								<option label="Apply Model to New Time Series (ts)" value="ts" checked="true" />
								<option label="Forecast Directly from Saved Model (No new data)" value="direct" />
							</radio>
							<frame label="New Data Options" id="frm_app_new">
								<varslot id="app_ts" label="New Time Series (ts)" source="app_vs" classes="ts" />
								<radio id="app_reest" label="Parameter Handling">
									<option label="Keep Saved Parameters (No re-estimation — SPSS Apply Mode)" value="keep" checked="true" />
									<option label="Re-estimate Parameters on New Data (Keep Model Structure)" value="refit" />
								</radio>
							</frame>
							<spinbox label="Forecast Horizon (h)" id="app_h" initial="12" min="1" max="240" type="integer" />
							<stretch />
						</column>
					</tab>
					<tab label="Plot Options" id="tab_PltOptns">
						<column id="clm_fPCPCPT2MC">
							<frame label="Plot Customization" id="frm_PltCstmz">
								<dropdown id="app_theme" label="Plot Theme (ggplot2)">
									<option label="Minimal (Clean business look)" value="minimal" checked="true" />
									<option label="Classic (Scientific)" value="classic" />
									<option label="Black &amp; White (Grid)" value="bw" />
								</dropdown>
								<input label="Main Title (Leave empty for default)" id="app_plot_main" />
								<input label="X-Axis Label (Leave empty for default)" id="app_plot_xlab" />
								<input label="Y-Axis Label (Leave empty for default)" id="app_plot_ylab" />
							</frame>
							<stretch />
						</column>
					</tab>
					<tab label="Output" id="tab_Output">
						<column id="clm_fSOWSOWSAF">
							<frame label="Save Objects to Workspace" id="frm_SvObjctW">
								<saveobject label="Save Applied Forecast as" checkable="true" checked="true" initial="applied_forecast" id="app_save_fc" />
								<saveobject label="Save Applied Model as" checkable="true" initial="applied_model" id="app_save_mod" />
							</frame>
							<frame label="HTML Graphics Size &amp; Resolution" id="frm_HTMLGrSR">
								<row id="row_sHTMLPW800">
									<spinbox label="HTML Plot Width (pixels)" id="app_plot_w" initial="800" min="100" max="5000" type="integer" />
									<spinbox label="HTML Plot Height (pixels)" id="app_plot_h" initial="600" min="100" max="5000" type="integer" />
									<spinbox label="Resolution (DPI)" id="app_plot_res" initial="120" min="72" max="600" type="integer" />
								</row>
							</frame>
							<frame label="Save Plot Object" id="frm_SvPltObj">
								<saveobject label="Save Plot (ggplot2) as" checkable="true" initial="applied_plot" id="app_save_plot" />
							</frame>
							<stretch />
						</column>
					</tab>
				</tabbook>
				<preview label="Preview Applied Forecast Plot" id="prv_PrvwApFP" />
			</column>
		</row>
	</dialog>
</document>
